# tripla 専用 Fastfile（Flutter）
# 中央共通版との違い: ビルド番号は increment_build_number を使わない。
# Flutter プロジェクトでは CURRENT_PROJECT_VERSION が "$(FLUTTER_BUILD_NUMBER)" で、
# 値は workflow 側の `flutter build ios --config-only --build-number` が
# Generated.xcconfig に書き込む。increment_build_number は Apple Generic
# Versioning 前提で tripla では失敗するため、lane から外している。
require "base64"

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: Base64.decode64(ENV.fetch("ASC_KEY_CONTENT_BASE64")),
    in_house: false
  )
end

platform :ios do
  desc "ビルドから TestFlight アップロードまで一括（Flutter）"
  lane :beta do
    api_key = asc_api_key

    workspace = ENV["IOS_WORKSPACE"]
    workspace = nil if workspace.nil? || workspace.empty?
    project = ENV["IOS_PROJECT"]
    project = nil if project.nil? || project.empty?

    # 自動署名でプロファイルを作成・取得するには、xcodebuild へも API キー認証を渡す必要がある
    key_path = File.expand_path("~/private_keys/AuthKey_#{ENV.fetch("ASC_KEY_ID")}.p8")
    xcargs = "-allowProvisioningUpdates" \
      " -authenticationKeyPath #{key_path}" \
      " -authenticationKeyID #{ENV.fetch("ASC_KEY_ID")}" \
      " -authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}"

    build_app(
      scheme: ENV.fetch("IOS_SCHEME"),
      workspace: workspace,
      project: project,
      export_method: "app-store",
      xcargs: xcargs
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
